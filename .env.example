# RBG Candidate — Environment Variables Template
# Copy to .env and fill in values. Never commit .env
# server/config.py loads this file automatically (existing env vars win).

# NVIDIA API key for model access (format: nvapi-...)
NVIDIA_API_KEY=

# Server port (default: 8000)
PORT=8000

# Comma-separated allowed CORS origins for development
# (chrome-extension://<id> origins are allowed via ALLOWED_ORIGIN_REGEX)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI coordinator + worker pool ────────────────────────────────────────
# Number of parallel AI workers (each owns an HTTP client, a fast model and a quality model)
AI_WORKERS=15
# Fast tier: short answers + dropdown choices. Quality tier: cover letters / long text.
NVIDIA_FAST_MODELS=meta/llama-3.1-8b-instruct,mistralai/mistral-small-3.1-24b-instruct-2503
NVIDIA_QUALITY_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1.5
# Shared request budget for all workers (NVIDIA free tier is about 40/min)
NVIDIA_MAX_RPM=40
# Drop configured models the key cannot see (GET /v1/models at start-up)
AI_DISCOVER_MODELS=1
# Retries / timeouts / circuit breaker
AI_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_S=45
AI_TASK_TIMEOUT_S=60
AI_FAILURE_THRESHOLD=3
AI_COOLDOWN_S=30
# Point at scripts/fake_nvidia_server.py for offline demos: http://127.0.0.1:9100/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Only set to 1 behind a trusted reverse proxy (otherwise X-Forwarded-For is spoofable)
TRUST_PROXY_HEADERS=0

# Set to 1 to withhold the operator key: /fill and /analyze then REQUIRE the
# caller's own key (BYOK) — protects your quota on public deployments
FILL_REQUIRE_BYOK=0
